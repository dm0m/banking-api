				{
					"name": "3. Duplicate email, different case -> 409",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Setup: create the customer(s) this request needs, then send the request.",
									"pm.sendRequest({",
									"  url: pm.variables.get('baseUrl') + '/customers',",
									"  method: 'POST',",
									"  header: { 'Content-Type': 'application/json' },",
									"  body: { mode: 'raw', raw: JSON.stringify({",
									"    firstName: 'John', lastName: 'Doe', phone: '+33612345678',",
									"    email: pm.variables.get('emailA'), dob: '1990-05-15',",
									"    address: { streetNo: '12', street: 'Rue de Rivoli', city: 'Paris',",
									"               state: 'Ile-de-France', zipCode: '75001', country: 'FR' } }) }",
									"}, (err, res) => {",
									"  if (err || res.code !== 201) {",
									"    console.error('Setup: creating customer John failed', err || res.code, res && res.text());",
									"    return;",
									"  }",
									"  pm.variables.set('customerId', res.json().id);",
									"  console.log('Setup: created customer John with id', res.json().id);",
									"});"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 409', () => pm.response.to.have.status(409));",
									"pm.test('body is a ProblemDetail', () => {",
									"  const b = pm.response.json();",
									"  pm.expect(b.status).to.eql(409);",
									"  pm.expect(b).to.have.property('title');",
									"});"
								]
