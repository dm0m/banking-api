{
	"info": {
		"_postman_id": "b62e687d-0df2-4378-9244-066294fa1255",
		"name": "Banking API - Customers",
		"description": "Each request is self-contained: the collection pre-request script creates any customer a request needs. Requests can be sent individually or run in any order.",
