	"item": [
		{
			"name": "Create",
			"item": [
				{
					"name": "1. Create customer A (valid)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 201', () => pm.response.to.have.status(201));",
									"const b = pm.response.json();",
									"pm.test('Location header points to new customer', () => {",
									"  pm.expect(pm.response.headers.get('Location')).to.include('/customers/' + b.id);",
									"});",
									"pm.test('response has id, address and audit dates', () => {",
									"  pm.expect(b.id).to.be.a('number');",
									"  pm.expect(b.address.city).to.eql('Paris');",
									"  pm.expect(b.createdAt).to.be.a('string');",
									"});",
									"pm.test('email stored as sent (already lowercase)', () => {",
									"  pm.expect(b.email).to.eql(pm.variables.get('emailA'));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/customers",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"customers"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+33612345678\",\n  \"email\": \"{{emailA}}\",\n  \"address\": {\n    \"streetNo\": \"12\",\n    \"street\": \"Rue de Rivoli\",\n    \"city\": \"Paris\",\n    \"state\": \"Ile-de-France\",\n    \"zipCode\": \"75001\",\n    \"country\": \"FR\"\n  },\n  \"dob\": \"1990-05-15\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
